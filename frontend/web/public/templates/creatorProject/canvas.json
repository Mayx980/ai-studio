  "edges": [
    {
      "id": "requestToVideo",
      "source": "creativeRequest",
      "sourceHandle": "text",
      "target": "creatorVideo",
      "targetHandle": "in"
    },
    {
      "id": "referenceToVideo",
      "source": "referenceFrame",
      "sourceHandle": "image",
      "target": "creatorVideo",
      "targetHandle": "in"
