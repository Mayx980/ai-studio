{
  "name": "@ai-studio/creation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:check": "node scripts/asset-optimize.mjs --dry-run",
    "assets:font-subset": "node scripts/font-subset.mjs",
    "assets:optimize": "node scripts/asset-optimize.mjs --write",
    "audit:prod": "node scripts/production-dependency-audit.mjs",
    "build": "vite build --mode production && node scripts/check-isolation.mjs --mode production",
    "build:scenario": "vite build --mode scenario && node scripts/check-isolation.mjs --mode scenario",
    "check:bundle": "node scripts/bundle-check.mjs",
    "check:prebuild": "node scripts/prebuild-check.mjs",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,cjs,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,cjs,mjs,json,md}\"",
    "lint": "pnpm run lint:js && pnpm run lint:vue",
    "lint:js": "oxlint --deny-warnings --ignore-pattern '**/*.vue' src scripts e2e eslint.config.js playwright.config.js prettier.config.cjs vite.config.js vitest.config.js",
    "lint:vue": "eslint \"src/**/*.vue\"",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "scenario": "vite --mode scenario",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-table": "9.2.4",
    "@tanstack/vue-virtual": "3.13.36",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/components": "14.3.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/router": "14.3.0",
    "am-check-version": "1.0.7",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.20",
    "echarts": "6.1.0",
    "lodash-es": "4.18.1",
    "nanoid": "5.1.16",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.3.1",
    "vue": "3.5.35",
    "vue-i18n": "11.4.2",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.127",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-legacy": "8.0.1",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "10.4.1",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.6.0",
    "happy-dom": "20.11.6",
    "oxlint": "1.79.0",
    "prettier": "3.8.3",
    "rollup-plugin-visualizer": "7.0.1",
    "sharp": "0.34.5",
    "svgo": "4.0.1",
    "tailwindcss": "4.3.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.16",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.8"
  }
}
